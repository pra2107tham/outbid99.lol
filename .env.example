# ---------------------------------------------------------------------------
# outbid99.lol
#
# With none of this set the site runs against a local JSON store seeded with
# the launch board, so it builds, renders and demos out of the box. Fill these
# in to move it onto real infrastructure.
# ---------------------------------------------------------------------------

# Canonical origin. Used for canonicals, OG image URLs, the sitemap and the
# post-checkout return URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://outbid99.lol

# --- Database -------------------------------------------------------------
# Run supabase/schema.sql against the project first, then `npm run seed`.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, read-only fallback if the service role key is absent.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Payments (Dodo Payments) ---------------------------------------------
# DODO_PRODUCT_ID must point at a one-time product with pay-what-you-want
# pricing enabled: the bid amount is set per checkout session, not per product.
DODO_API_KEY=
DODO_PRODUCT_ID=
DODO_WEBHOOK_SECRET=
# test_mode while wiring up, live_mode once real cards are taken.
DODO_ENVIRONMENT=test_mode

# --- Admin ----------------------------------------------------------------
# Enables /admin and POST /api/admin. Both 404 while this is unset.
ADMIN_SECRET=

# --- Analytics ------------------------------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=outbid99.lol
NEXT_PUBLIC_PLAUSIBLE_PUBLIC_URL=https://plausible.io/outbid99.lol

# --- Local development only -----------------------------------------------
# Lets the scraper reach private addresses. Never set this in production: it
# turns the scrape endpoint into an SSRF probe.
# OUTBID99_ALLOW_PRIVATE_SCRAPE=1
